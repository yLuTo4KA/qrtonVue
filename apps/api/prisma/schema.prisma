// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  telegramId    BigInt   @unique
  telegramHash  String
  firstName     String?
  lastName      String?
  username      String?
  photoUrl      String?
  isBot         Boolean  @default(false)
  languageCode  String?
  isPremium     Boolean  @default(false)
  access        Boolean  @default(false)
  admin         Boolean  @default(false)
  plt_login     String?
  plt_pass      String?
  nickname      String?
  device        String?
  groupId       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group         Group?   @relation("UserToGroup", fields: [groupId], references: [id])
  groupsOwned   Group[]  @relation("GroupOwner")
  groupMembers  GroupMember[]
  attendance    Attendance[]

  @@index([telegramId])
  @@index([groupId])
}

model Group {
  id            String   @id @default(cuid())
  title         String
  description   String?
  adminId       String
  isActive      Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin         User     @relation("GroupOwner", fields: [adminId], references: [id], onDelete: Cascade)
  members       User[]   @relation("UserToGroup")
  groupMembers  GroupMember[]
  attendance    Attendance[]

  @@index([adminId])
}

model GroupMember {
  id            String   @id @default(cuid())
  userId        String
  groupId       String
  status        String   @default("pending") // pending, approved, rejected
  joinedAt      DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  groupId       String
  date          DateTime @default(now())
  authStatus    String   @default("pending") // Full message for auth status
  scanStatus    String   @default("absent") // Full message for scan status
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, date])
  @@index([userId])
  @@index([groupId])
}
