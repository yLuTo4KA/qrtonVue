{
  "buildCommand": "npm install && npx prisma migrate deploy && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api.ts": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
